---
/**
 * ═════════════════════════════════════════════════════════════
 * [SECTION] Research Statement Page — Long-Term Research Vision
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Academic statement of research vision, methodology, and doctoral
 *               prospectus for PhD applications and prospective supervisors.
 * Props       : None (Static route)
 * Data Source : src/content/site/profile.yaml & in-page structured narrative
 * Used in     : Route /research-statement
 * How to Edit : [MANUAL-UPDATE] Customize sections below for your target PhD proposal.
 * ═════════════════════════════════════════════════════════════
 */

import PageLayout from '../layouts/PageLayout.astro';
import DraftBadge from '../components/ui/DraftBadge.astro';
import { getEntry } from 'astro:content';

// [DATA] Load profile information
const profileEntry = await getEntry('site', 'profile');
const profile = profileEntry?.data || {
  name: 'Nazmul Hasan Shouvo',
  institution: 'Canterbury Christ Church University (CCCU), United Kingdom',
  email: 'mdnazmulhasanshouv@gmail.com',
};

const tocItems = [
  { id: 'vision', title: '1. Research Vision' },
  { id: 'current-work', title: '2. Current Work: 3D Pancreatic CT' },
  { id: 'methodology', title: '3. Methods & Technical Strengths' },
  { id: 'future-directions', title: '4. Future Directions' },
  { id: 'doctoral-goals', title: '5. Why Doctoral Study' },
  { id: 'references', title: '6. Key References' },
];
---

<PageLayout
  title="Research Statement | Nazmul Hasan Shouvo · Academic Portfolio"
  description="Long-form research statement, technical methodology, and doctoral research vision of Nazmul Hasan Shouvo — Pancreatic CT Segmentation and Trustworthy Medical AI."
  activeHref="/research-statement"
>
  <div class="statement-page">
    {/* ═══════════════════════════════════════════════════════════════
        [SECTION] Page Header — Statement Header & Actions
        ═══════════════════════════════════════════════════════════════ */}
    <header class="statement-header">
      <div class="container">
        <div class="header-breadcrumbs">
          <a href="/">Home</a>
          <span class="sep">/</span>
          <a href="/research">Research</a>
          <span class="sep">/</span>
          <span class="current">Research Statement</span>
        </div>

        <div class="title-row">
          <div>
            <div class="badge-wrap">
              <span class="doc-badge">Academic Statement · PhD Prospectus</span>
              <DraftBadge text="Demo Draft — Verify before submitting" />
            </div>
            <h1 class="statement-title">Statement of Research Vision & Future Directions</h1>
            <p class="statement-subtitle">
              Advancing Clinically Reliable, Explainable Deep Learning and Vision Transformers for 3D Medical Image Segmentation
            </p>
          </div>

          <div class="header-actions">
            <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()" aria-label="Print or save as PDF">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              <span>Print / Save PDF</span>
            </button>
            <a href="/contact" class="btn btn-primary btn-sm">
              <span>Discuss Supervision ↗</span>
            </a>
          </div>
        </div>

        <div class="author-meta-bar">
          <div class="meta-item">
            <span class="meta-label">Author:</span>
            <span class="meta-value"><strong>{profile.name}</strong></span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Institution:</span>
            <span class="meta-value">{profile.institution}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Primary Focus:</span>
            <span class="meta-value">Pancreatic CT Analysis & XAI</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Last Updated:</span>
            <span class="meta-value"><time datetime="2026-10">October 2026</time></span>
          </div>
        </div>
      </div>
    </header>

    {/* ═══════════════════════════════════════════════════════════════
        [SECTION] Main Statement Layout: Sticky TOC + Reading Column
        ═══════════════════════════════════════════════════════════════ */}
    <div class="container statement-content-grid">
      {/* Sticky Table of Contents Sidebar */}
      <aside class="statement-sidebar" aria-label="Table of Contents">
        <div class="toc-sticky-card">
          <div class="toc-heading">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            <span>Statement Outline</span>
          </div>
          <nav class="toc-nav">
            <ul class="toc-list">
              {tocItems.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="toc-link">
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <div class="toc-footer-card">
            <p class="toc-note-title">[MANUAL-UPDATE] Customization Note</p>
            <p class="toc-note-body">
              Before submitting for PhD applications, tailor these sections to align with the prospective university's research focus and supervisor's recent publications.
            </p>
          </div>
        </div>
      </aside>

      {/* Primary Document Body */}
      <article class="statement-body" id="statement-text">
        {/* Callout Notice for Prospective Supervisors */}
        <div class="supervisor-alert" role="region" aria-label="Academic Prospectus Notice">
          <div class="alert-icon" aria-hidden="true">💡</div>
          <div class="alert-content">
            <h2 class="alert-title">Prospective Doctoral Supervisor & Reviewer Summary</h2>
            <p class="alert-text">
              This statement synthesizes my research trajectory as a Research Assistant at Canterbury Christ Church University (CCCU), UK, bridging 10 accepted peer-reviewed publications, 3 forthcoming book chapters (Bentham Science), and ongoing 3D pancreatic CT segmentation research into an overarching doctoral agenda focused on trustworthy, clinically calibrated AI.
            </p>
          </div>
        </div>

        {/* ─── 1. Research Vision ─── */}
        <section id="vision" class="statement-section">
          <h2 class="section-heading">1. Overarching Research Vision</h2>
          <p class="lead-paragraph">
            The translation of computer vision into clinical oncology remains bottlenecked by two persistent challenges: high false-alarm rates in boundary delineation of anatomically variable soft-tissue organs, and the opacity of high-capacity models that leaves clinicians unable to calibrate algorithmic risk.
          </p>
          <p>
            My overarching research objective is to develop <strong>robust, explainable, and sample-efficient 3D deep learning architectures</strong> for medical volumetric imaging. Rather than treating organ segmentation as a generic dense prediction problem, my work investigates how domain-informed inductive biases—such as anatomical shape priors, multi-scale volumetric attention, and post-hoc attribution maps—can bridge the gap between benchmark benchmark metrics and bedside clinical trust.
          </p>
          <p>
            Over the next 4–5 years, I aim to establish unified computational pipelines capable of simultaneously executing voxel-wise segmentation, uncertainty quantification, and interpretable clinical reasoning across multi-center abdominal CT cohorts.
          </p>
        </section>

        {/* ─── 2. Current Work: 3D Pancreatic CT Segmentation ─── */}
        <section id="current-work" class="statement-section">
          <h2 class="section-heading">2. Current Work: 3D Pancreatic CT Volumetric Analysis</h2>
          <div class="section-callout">
            <span class="callout-tag">[CURRENT FOCUS] Canterbury Christ Church University (2026 – Present)</span>
            <p>
              Under my ongoing MSc Data Intelligence dissertation and Research Assistant placement at CCCU, I lead experiments on automated pancreatic parenchymal and lesion segmentation on abdominal contrast-enhanced CT scans.
            </p>
          </div>
          <p>
            The human pancreas poses one of the most demanding benchmarks in medical image analysis: it occupies less than 0.5% of total abdominal volume, exhibits high inter-patient morphological variation, and possesses Hounsfield Unit (HU) intensity distributions that overlap heavily with adjacent duodenum, stomach, and splenic vessels.
          </p>
          <h3>Key Methodological Interventions in Progress:</h3>
          <ul>
            <li>
              <strong>Hounsfield Unit (HU) Calibration:</strong> Implementing multi-window intensity normalization that preserves both soft-tissue parenchymal texture and vascular margins while suppressing extraneous pelvic and thoracic air/bone artifacts.
            </li>
            <li>
              <strong>Hybrid CNN-Transformer Topologies:</strong> Investigating volumetric Swin-UNETR and hybrid 3D CNNs to capture both local voxel gradients (essential for irregular parenchymal boundaries) and global long-range contextual relationships across axial slices.
            </li>
            <li>
              <strong>Class Imbalance Alleviation:</strong> Formulating customized Compound Loss objectives combining Soft Dice with Focal Cross-Entropy to penalize severe foreground-background voxel disparity without causing gradient saturation.
            </li>
          </ul>
        </section>

        {/* ─── 3. Methods & Technical Strengths ─── */}
        <section id="methodology" class="statement-section">
          <h2 class="section-heading">3. Methods & Methodological Strengths</h2>
          <p>
            My prior research across 10 peer-reviewed papers and 3 book chapters demonstrates a consistent methodology rooted in reproducible experimentation, rigorous ablation studies, and clinical explainability:
          </p>
          <div class="methods-bento">
            <div class="method-card">
              <h3 class="method-title">Explainable AI (XAI)</h3>
              <p class="method-desc">
                Specialized in gradient-weighted class activation mapping (Grad-CAM), Layer-CAM, and SHAP to ensure decision boundaries correlate with genuine pathology rather than image capture artifacts.
              </p>
            </div>
            <div class="method-card">
              <h3 class="method-title">Compound Scaling & ViTs</h3>
              <p class="method-desc">
                Experience engineering tailored attention backbones (MobileNetV2-SA, EfficientNet, Vision Transformers) designed to maximize feature discrimination under restricted compute budgets.
              </p>
            </div>
            <div class="method-card">
              <h3 class="method-title">Threshold Ensembles</h3>
              <p class="method-desc">
                Pioneered weighted threshold optimization and meta-stacking classifiers to improve diagnostic recall on high-stakes clinical disease cohorts (IEEE QPAIN 2026, ICECTE 2026).
              </p>
            </div>
            <div class="method-card">
              <h3 class="method-title">Medical Data Pipelines</h3>
              <p class="method-desc">
                End-to-end fluency with DICOM / NIfTI formats, MONAI, SimpleITK, 3D Slicer, and PyTorch for reproducible 3D medical data loaders and augmentation pipelines.
              </p>
            </div>
          </div>
        </section>

        {/* ─── 4. Future Directions ─── */}
        <section id="future-directions" class="statement-section">
          <h2 class="section-heading">4. Proposed Doctoral Research Directions</h2>
          <p>
            During doctoral study, I propose to explore three tightly coupled investigative tracks that extend my master's foundation:
          </p>
          <ol class="proposals-list">
            <li>
              <strong>Uncertainty-Aware 3D Volumetric Segmentation:</strong>
              Developing Bayesian neural networks and test-time augmentation ensembling to produce spatial confidence maps alongside binary segmentation masks, signaling to radiologists where an automated boundary requires manual verification.
            </li>
            <li>
              <strong>Multi-Modal Cross-Attention Fusion:</strong>
              Integrating patient clinical metadata (demographic biomarkers, laboratory serum levels, staging records) with 3D radiological volumes via cross-modal attention transformers to refine borderline differential diagnoses.
            </li>
            <li>
              <strong>Federated and Privacy-Preserving Medical AI:</strong>
              Investigating parameter-efficient fine-tuning (PEFT) and federated averaging strategies to enable distributed model training across hospital networks without transmitting sensitive patient DICOM archives.
            </li>
          </ol>
        </section>

        {/* ─── 5. Why Doctoral Study ─── */}
        <section id="doctoral-goals" class="statement-section">
          <h2 class="section-heading">5. Motivation for Doctoral Research</h2>
          <p>
            My transition from core computer science at IUBAT (graduating with CGPA 3.84/4.00 and an IEEE ICCIT publication) to advanced Data Intelligence at Canterbury Christ Church University (averaging Distinction 70%) has reinforced my commitment to an academic research career.
          </p>
          <p>
            A PhD will provide the dedicated intellectual environment and rigorous supervisory mentorship necessary to develop fundamentally novel AI architectures rather than merely adapting existing models. I look forward to joining a collaborative research lab where my strong work ethic, proven publication velocity (15 authored works spanning 2024–2026), and technical fluency in PyTorch and medical imaging can contribute immediately to ongoing funded grants.
          </p>
        </section>

        {/* ─── 6. Key References ─── */}
        <section id="references" class="statement-section">
          <h2 class="section-heading">6. Representative Relevant Publications</h2>
          <ul class="references-list">
            <li>
              <strong>Shouvo, N. H.</strong>, et al. (2026). "Class-Weighted ResNet50 for Robust Guava Leaf Disease Classification under Real-Field Conditions." In <em>IEEE QPAIN 2026</em>, pp. 1–6. [First Author].
            </li>
            <li>
              Rakin, A., <strong>Shouvo, N. H.</strong>, et al. (2026). "Robust AIDS Disease Classification Using a Threshold-Optimized Weighted Ensemble." In <em>IEEE QPAIN 2026</em>, pp. 1–6.
            </li>
            <li>
              Haque, O., ..., <strong>Shouvo, N. H.</strong> (2026). "Explainable Stacking Machine Learning Ensemble Model for Liver Disease Prediction." In <em>IEEE ICECTE 2026</em>, pp. 1–6.
            </li>
            <li>
              Chayon, M. H. R., <strong>Shouvo, N. H.</strong>, & Al Mamun, M. A. (2024). "An Efficient Scheduling Algorithm Based on Buffer Status in 5G." In <em>IEEE ICCIT 2024</em>, pp. 2014–2019. DOI: 10.1109/ICCIT64658.2024.10892014.
            </li>
          </ul>
        </section>

        {/* Action Band */}
        <div class="statement-action-band">
          <div class="action-copy">
            <h3>Explore Research Publications & Case Studies</h3>
            <p>Review the empirical benchmarks, methodology breakdowns, and code repositories supporting this statement.</p>
          </div>
          <div class="action-btns">
            <a href="/research" class="btn btn-primary">View Case Studies</a>
            <a href="/publications" class="btn btn-secondary">Browse Publications</a>
          </div>
        </div>
      </article>
    </div>
  </div>
</PageLayout>

<style>
  .statement-page {
    padding-bottom: var(--space-24);
  }

  /* Header */
  .statement-header {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-8) 0 var(--space-10);
  }

  .header-breadcrumbs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .header-breadcrumbs a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .header-breadcrumbs a:hover {
    color: var(--color-accent);
  }

  .header-breadcrumbs .current {
    color: var(--color-text-primary);
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .badge-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .doc-badge {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
  }

  .statement-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-family: var(--font-serif);
    color: var(--color-text-primary);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
    max-width: 850px;
  }

  .statement-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 800px;
    line-height: var(--leading-relaxed);
  }

  .header-actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-shrink: 0;
  }

  .author-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }

  .meta-item {
    display: flex;
    gap: var(--space-2);
  }

  .meta-label {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
  }

  .meta-value {
    color: var(--color-text-primary);
  }

  /* Content Grid */
  .statement-content-grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--space-12);
    margin-top: var(--space-10);
    align-items: start;
  }

  /* Sticky Sidebar */
  .statement-sidebar {
    position: sticky;
    top: calc(72px + var(--space-6));
  }

  .toc-sticky-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
  }

  .toc-heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .toc-link {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    line-height: var(--leading-normal);
  }

  .toc-link:hover {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    transform: translateX(2px);
  }

  .toc-footer-card {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
    font-size: var(--text-xs);
  }

  .toc-note-title {
    font-family: var(--font-mono);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    margin-bottom: var(--space-1);
  }

  .toc-note-body {
    color: var(--color-text-tertiary);
    line-height: var(--leading-relaxed);
  }

  /* Body Content */
  .statement-body {
    max-width: 780px;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-primary);
  }

  .supervisor-alert {
    display: flex;
    gap: var(--space-4);
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .alert-icon {
    font-size: var(--text-2xl);
    flex-shrink: 0;
  }

  .alert-title {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .alert-text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .statement-section {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .statement-section:last-of-type {
    border-bottom: none;
  }

  .section-heading {
    font-size: var(--text-2xl);
    font-family: var(--font-serif);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
    padding-top: var(--space-2);
  }

  .statement-body p {
    margin-bottom: var(--space-4);
    color: var(--color-text-secondary);
  }

  .statement-body p strong {
    color: var(--color-text-primary);
  }

  .lead-paragraph {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-primary) !important;
  }

  .section-callout {
    background: var(--color-bg-secondary);
    border-left: 3px solid var(--color-accent);
    padding: var(--space-4) var(--space-5);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-5) 0;
  }

  .callout-tag {
    display: block;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .section-callout p {
    margin: 0;
  }

  .statement-body h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    margin: var(--space-6) 0 var(--space-3);
  }

  .statement-body ul,
  .statement-body ol {
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
    color: var(--color-text-secondary);
  }

  .statement-body li {
    margin-bottom: var(--space-3);
    line-height: var(--leading-relaxed);
  }

  /* Methods Bento */
  .methods-bento {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  .method-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .method-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: var(--space-2);
  }

  .method-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-normal);
  }

  /* References */
  .references-list {
    list-style: square;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
  }

  .references-list li {
    margin-bottom: var(--space-3);
  }

  /* Action Band */
  .statement-action-band {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    margin-top: var(--space-8);
  }

  .action-copy h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
  }

  .action-copy p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .action-btns {
    display: flex;
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    .statement-content-grid {
      grid-template-columns: 1fr;
    }

    .statement-sidebar {
