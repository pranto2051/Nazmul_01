---
/**
 * ═════════════════════════════════════════════════════════════
 * [SECTION] 404 Error Page — Slice Not Found
 * ─────────────────────────────────────────────────────────────
 * Purpose     : On-brand clinical PACS diagnostic 404 error page.
 * Props       : None
 * Data Source : Static route
 * Used in     : Rendered automatically on unfound routes
 * How to Edit : Update text and recovery navigation links below.
 * ═════════════════════════════════════════════════════════════
 */

import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="404 — Slice Not Found | Nazmul Hasan Shouvo"
  description="The requested medical volume or page could not be reconstructed."
  activeHref="/404"
>
  <div class="not-found-page">
    <div class="container not-found-inner">
      {/* ═══════════════════════════════════════════════════════════════
          [SECTION] Diagnostic Scan Viewport (404 Error Frame)
          ═══════════════════════════════════════════════════════════════ */}
      <div class="scanner-frame" aria-hidden="true">
        <div class="scanner-overlay">
          <span class="corner-marker top-left"></span>
          <span class="corner-marker top-right"></span>
          <span class="corner-marker bottom-left"></span>
          <span class="corner-marker bottom-right"></span>
          <div class="scanline"></div>
          
          <div class="scanner-metadata top">
            <span>SERIES: ERROR_HANDLER</span>
            <span>MODALITY: CT_VOLUMETRIC</span>
          </div>

          <div class="scanner-center">
            <span class="error-code">404</span>
            <span class="error-glitch">SLICE_NOT_FOUND</span>
          </div>

          <div class="scanner-metadata bottom">
            <span>SLICE: NaN / OUT_OF_BOUNDS</span>
            <span>STATUS: SEGMENTATION_FAULT</span>
          </div>
        </div>
      </div>

      {/* ═══════════════════════════════════════════════════════════════
          [SECTION] Explanatory Text & Recovery Links
          ═══════════════════════════════════════════════════════════════ */}
      <div class="error-content">
        <h1 class="error-title">Axial Slice Not Found</h1>
        <p class="error-desc">
          The requested radiological volume or web page slice could not be reconstructed. 
          The file may have been moved, renamed, or de-indexed.
        </p>

        <div class="quick-nav-box">
          <h2 class="quick-nav-title">Recommended Recovery Routes:</h2>
          <div class="quick-nav-links">
            <a href="/" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              <span>Return to Home</span>
            </a>
            <a href="/publications" class="btn btn-secondary">Publications Browser</a>
            <a href="/research" class="btn btn-secondary">Research Studies</a>
            <a href="/experience" class="btn btn-secondary">Experience & Skills</a>
            <a href="/cv" class="btn btn-secondary">Academic CV</a>
            <a href="/contact" class="btn btn-secondary">Contact</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .not-found-page {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) 0 var(--space-20);
  }

  .not-found-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Diagnostic PACS Scanner Box */
  .scanner-frame {
    width: 280px;
    height: 280px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
    margin-bottom: var(--space-8);
    box-shadow: var(--shadow-md);
  }

  .scanner-overlay {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-3);
    box-sizing: border-box;
    font-family: var(--font-mono);
  }

  .corner-marker {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--color-accent);
    border-style: solid;
    pointer-events: none;
  }

  .top-left {
    top: 8px;
    left: 8px;
    border-width: 2px 0 0 2px;
  }

  .top-right {
    top: 8px;
    right: 8px;
    border-width: 2px 2px 0 0;
  }

  .bottom-left {
    bottom: 8px;
    left: 8px;
    border-width: 0 0 2px 2px;
  }

  .bottom-right {
    bottom: 8px;
    right: 8px;
    border-width: 0 2px 2px 0;
  }

  .scanline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0.7;
    animation: scanAnim 3.5s ease-in-out infinite alternate;
  }

  @keyframes scanAnim {
    0% {
      top: 5%;
    }
    100% {
      top: 95%;
    }
  }

  .scanner-metadata {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  .scanner-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .error-code {
    font-size: 4rem;
    font-weight: var(--weight-bold);
    font-family: var(--font-mono);
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .error-glitch {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    letter-spacing: 0.15em;
    margin-top: var(--space-1);
  }

  /* Content */
  .error-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    font-family: var(--font-serif);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .error-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  .quick-nav-box {
    width: 100%;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .quick-nav-title {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .quick-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .scanline {
      animation: none;
      top: 50%;
    }
  }
</style>
