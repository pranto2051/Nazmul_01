---
/**
 * ═════════════════════════════════════════════════════════════
 * [LAYOUT] PrintLayout — CV Print & Web Preview Layout
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Minimalist web frame designed for clean A4 printing & PDF export.
 * Props       : title, description, pdfDownloadUrl
 * Data Source : Page props
 * Used in     : src/pages/cv.astro
 * How to Edit : Modify print toolbar or actions below.
 * ═════════════════════════════════════════════════════════════
 */

import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  pdfDownloadUrl?: string;
}

const {
  title = 'Nazmul Hasan Shouvo — Academic Curriculum Vitae',
  description = 'Curriculum Vitae of Nazmul Hasan Shouvo — Research Assistant at Canterbury Christ Church University (CCCU), UK.',
  pdfDownloadUrl = '/cv/YOUR_NAME_CV.pdf',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <!-- Print Control Bar (Hidden when printed via @media print) -->
  <div class="print-control-bar no-print">
    <div class="container bar-inner">
      <a href="/" class="back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to Website</span>
      </a>

      <div class="bar-actions">
        <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print / Save PDF (A4)
        </button>

        <a href={pdfDownloadUrl} class="btn btn-primary btn-sm" download>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download PDF
        </a>
      </div>
    </div>
  </div>

  <main id="main-content" class="print-main-content">
    <slot />
  </main>
</BaseLayout>

<style>
  .print-control-bar {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-hairline);
    padding: 0.85rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-sm);
  }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .bar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .print-main-content {
    padding: 3rem 0;
  }

  @media print {
    .print-control-bar {
      display: none !important;
    }

    .print-main-content {
      padding: 0 !important;
    }
  }
</style>
