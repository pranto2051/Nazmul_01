---
/**
 * ═════════════════════════════════════════════════════════════
 * [COMPONENT] Lightbox — Gallery and Media Full-Screen Dialog
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Native <dialog> full-screen image preview, next/prev navigation,
 *               keyboard arrow handling, zoom toggling, captions, and credits.
 * ═════════════════════════════════════════════════════════════
 */
---

<dialog id="global-lightbox-dialog" class="lightbox-dialog" aria-label="Image Lightbox Viewer">
  <div class="lightbox-backdrop-close" id="lightbox-backdrop-close" aria-hidden="true"></div>
  
  <div class="lightbox-frame">
    <!-- Top Bar Controls -->
    <div class="lightbox-top-bar">
      <div class="lightbox-counter font-mono" id="lightbox-counter">1 / 1</div>
      <div class="lightbox-tools">
        <button type="button" id="lightbox-zoom-btn" class="lightbox-tool-btn" title="Toggle zoom" aria-label="Toggle zoom">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>
        <button type="button" id="lightbox-close-btn" class="lightbox-tool-btn close-btn" title="Close viewer (Esc)" aria-label="Close viewer">
          ✕
        </button>
      </div>
    </div>

    <!-- Main Viewport Area with Nav Buttons -->
    <div class="lightbox-viewport">
      <button type="button" id="lightbox-prev-btn" class="lightbox-nav-btn prev-btn" aria-label="Previous figure">
        ‹
      </button>

      <div class="lightbox-image-stage" id="lightbox-stage">
        <img id="lightbox-img" src="" alt="" class="lightbox-display-img" />
      </div>

      <button type="button" id="lightbox-next-btn" class="lightbox-nav-btn next-btn" aria-label="Next figure">
        ›
      </button>
    </div>

    <!-- Bottom Caption & Credit Bar -->
    <div class="lightbox-caption-bar">
      <p id="lightbox-caption" class="lightbox-caption-text"></p>
      <span id="lightbox-credit" class="lightbox-credit-text font-mono"></span>
    </div>
  </div>
</dialog>

<style>
  .lightbox-dialog {
    margin: auto;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    background: transparent;
    border: none;
    padding: 0;
    overflow: hidden;
  }

  .lightbox-dialog::backdrop {
    background: rgba(8, 13, 20, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .lightbox-backdrop-close {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .lightbox-frame {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    pointer-events: none;
  }

  .lightbox-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: auto;
    z-index: 10;
  }

  .lightbox-counter {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 700;
    background: rgba(15, 23, 42, 0.7);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .lightbox-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lightbox-tool-btn {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: rgba(15, 23, 42, 0.7);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lightbox-tool-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .lightbox-viewport {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    pointer-events: auto;
    overflow: hidden;
  }

  .lightbox-nav-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.75);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 2rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .lightbox-nav-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.05);
  }

  .lightbox-image-stage {
    flex: 1;
    height: 100%;
    max-height: calc(100vh - 180px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 1rem;
  }

  .lightbox-display-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);
    transition: transform var(--transition-base);
  }

  .lightbox-display-img.zoomed {
    transform: scale(1.75);
    cursor: zoom-out;
  }

  .lightbox-caption-bar {
    pointer-events: auto;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.5rem;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: center;
    z-index: 10;
  }

  .lightbox-caption-text {
    color: #f1f5f9;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .lightbox-credit-text {
    color: var(--accent);
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .lightbox-nav-btn {
      width: 40px;
      height: 40px;
      font-size: 1.5rem;
    }
  }
</style>

<script>
  interface LightboxItem {
    src: string;
    alt: string;
    caption: string;
    credit: string;
    id?: string;
  }

  function setupGlobalLightbox() {
    const dialog = document.getElementById('global-lightbox-dialog') as HTMLDialogElement | null;
    const imgEl = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const captionEl = document.getElementById('lightbox-caption');
    const creditEl = document.getElementById('lightbox-credit');
    const counterEl = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');
    const zoomBtn = document.getElementById('lightbox-zoom-btn');
    const backdropClose = document.getElementById('lightbox-backdrop-close');

    if (!dialog || !imgEl) return;

    let items: LightboxItem[] = [];
    let currentIndex = 0;
    let triggerElement: HTMLElement | null = null;

    function gatherItems() {
      const figureEls = document.querySelectorAll<HTMLElement>('[data-lightbox="true"]');
      items = [];
      figureEls.forEach((el) => {
        const img = el.querySelector('img');
        const caption = el.closest('figure')?.querySelector('.caption-text')?.textContent || img?.alt || '';
        const credit = el.closest('figure')?.querySelector('.credit-text')?.textContent || '';
        const id = el.getAttribute('data-figure-id') || undefined;

        if (img) {
          items.push({
            src: img.src,
            alt: img.alt,
            caption,
            credit,
            id,
          });
        }
      });
    }

    function renderCurrent() {
      if (items.length === 0) return;
      const current = items[currentIndex];
      imgEl!.src = current.src;
      imgEl!.alt = current.alt;
      imgEl!.classList.remove('zoomed');
      if (captionEl) captionEl.textContent = current.caption;
      if (creditEl) creditEl.textContent = current.credit;
      if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${items.length}`;

      if (current.id) {
        window.history.replaceState(null, '', `#${current.id}`);
      }
    }

    function openAt(index: number, trigger?: HTMLElement) {
      gatherItems();
      if (items.length === 0) return;
      currentIndex = Math.max(0, Math.min(items.length - 1, index));
      triggerElement = trigger || null;
      renderCurrent();
      dialog!.showModal();
    }

    function close() {
      dialog!.close();
      if (window.location.hash) {
        window.history.replaceState(null, '', window.location.pathname + window.location.search);
      }
      triggerElement?.focus();
    }

    function next() {
      if (items.length <= 1) return;
      currentIndex = (currentIndex + 1) % items.length;
      renderCurrent();
    }

    function prev() {
      if (items.length <= 1) return;
      currentIndex = (currentIndex - 1 + items.length) % items.length;
      renderCurrent();
    }

    // Bind triggers
    document.querySelectorAll<HTMLElement>('[data-lightbox="true"]').forEach((el, idx) => {
      el.addEventListener('click', () => openAt(idx, el));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openAt(idx, el);
        }
      });
    });

    closeBtn?.addEventListener('click', close);
    backdropClose?.addEventListener('click', close);
    nextBtn?.addEventListener('click', next);
    prevBtn?.addEventListener('click', prev);

    zoomBtn?.addEventListener('click', () => {
      imgEl?.classList.toggle('zoomed');
    });

    imgEl?.addEventListener('click', () => {
      imgEl?.classList.toggle('zoomed');
    });

    // Keyboard handlers
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        next();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prev();
      } else if (e.key === 'Escape') {
        close();
      }
    });

    // Touch swipe handling
    let touchStartX = 0;
    dialog.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].clientX;
    }, { passive: true });

    dialog.addEventListener('touchend', (e) => {
      const diffX = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(diffX) > 50) {
        if (diffX < 0) next();
        else prev();
      }
    }, { passive: true });

    // Check deep-link hash on page load
    if (window.location.hash) {
      gatherItems();
      const hashId = window.location.hash.replace('#', '');
      const matchedIdx = items.findIndex(item => item.id === hashId);
      if (matchedIdx !== -1) {
        openAt(matchedIdx);
      }
    }
  }

  setupGlobalLightbox();
  document.addEventListener('astro:page-load', setupGlobalLightbox);
</script>
