---
/**
 * ═════════════════════════════════════════════════════════════
 * [CARD] ProjectCard — Project Card Component
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Academic and software engineering project card display.
 * Props       : project (title, context, period, category, description, stack, bullets, repoUrl, demoUrl)
 * Data Source : src/content/projects/projects.yaml
 * ═════════════════════════════════════════════════════════════
 */

interface Props {
  project: {
    id: string;
    title: string;
    context: string;
    period: string;
    category: string;
    description: string;
    stack: string[];
    bullets: string[];
    repoUrl?: string;
    demoUrl?: string;
  };
}

const { project } = Astro.props;
---

<article class="project-card card-surface" id={`proj-${project.id}`} data-category={project.category}>
  <div class="project-card-header">
    <div class="project-meta-row">
      <span class="project-category-badge font-mono">{project.category}</span>
      <span class="meta-dot">·</span>
      <span class="project-period font-mono">{project.period}</span>
    </div>
    <h3 class="paper-title project-title">{project.title}</h3>
    <p class="project-context font-mono">{project.context}</p>
  </div>

  <p class="project-desc">{project.description}</p>

  <ul class="project-bullets-list">
    {project.bullets.map((b) => (
      <li class="project-bullet-item">
        <span class="bullet-tick">▪</span>
        <span>{b}</span>
      </li>
    ))}
  </ul>

  <div class="project-stack-row">
    {project.stack.map((tech) => (
      <span class="chip font-mono">{tech}</span>
    ))}
  </div>

  {(project.repoUrl || project.demoUrl) && (
    <div class="project-links-row">
      {project.repoUrl && (
        <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
          <span>Repository</span>
        </a>
      )}
      {project.demoUrl && (
        <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
          <span>Live Demo</span>
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    box-shadow: var(--shadow-card);
    transition: all var(--transition-smooth);
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(56, 189, 248, 0.4);
  }

  .project-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project-meta-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    margin-bottom: 0.25rem;
  }

  .project-category-badge {
    color: var(--accent);
    background: var(--accent-subtle);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 0.74rem;
    letter-spacing: 0.05em;
  }

  .project-period {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .project-title {
    font-size: 1.35rem;
    color: var(--text-primary);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .project-context {
    font-size: 0.85rem;
    color: var(--accent-2);
    font-weight: 600;
  }

  .project-desc {
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .project-bullets-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .project-bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .bullet-tick {
    color: var(--accent);
    font-weight: 700;
    margin-top: -0.1rem;
  }

  .project-stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border-hairline);
  }

  .project-links-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
</style>
