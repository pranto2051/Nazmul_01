---
/**
 * ═════════════════════════════════════════════════════════════
 * [SECTION] Hero — High-Aesthetic Academic Hero Section
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Clean, modern introduction presenting identity, research focus,
 *               institutional affiliation, and floating interactive portrait.
 * Data Source : src/content/site/profile.yaml & src/data/images.ts
 * [IMAGE]     portrait key · 800×800
 * ═════════════════════════════════════════════════════════════
 */

import { IMG } from '../../data/images';

interface Props {
  profile: {
    name: string;
    currentRole: string;
    institution: string;
    positioningLine: string;
    bioShort: string;
    availability?: string;
    links: {
      linkedin?: string;
      googleScholar?: string;
      orcid?: string;
      github?: string;
    };
  };
}

const { profile } = Astro.props;
const portraitImg = IMG.portrait;
---

<section id="hero" class="hero-section">
  <!-- Ambient Atmospheric Aurora (Smooth gradients, no square grids) -->
  <div class="aurora-bg" aria-hidden="true">
    <div class="aurora-blob-1"></div>
    <div class="aurora-blob-2"></div>
    <div class="aurora-blob-3"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      {profile.availability && (
        <div class="availability-pill">
          <span class="pulsing-dot"></span>
          <span class="availability-text">{profile.availability}</span>
        </div>
      )}

      <div class="hero-header-group">
        <span class="hero-eyebrow font-mono">Academic Portfolio & Research Prospectus</span>
        <h1 class="hero-title text-hero">
          {profile.name}
        </h1>
      </div>

      <div class="hero-role-block">
        <p class="hero-role">{profile.currentRole}</p>
        <p class="hero-institution">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>{profile.institution}</span>
        </p>
      </div>

      <div class="hero-quote-card">
        <p class="hero-positioning text-title-3">
          "{profile.positioningLine}"
        </p>
      </div>

      <p class="hero-bio">
        {profile.bioShort}
      </p>

      <!-- CTA Buttons -->
      <div class="hero-cta-group">
        <a href="/publications" class="btn btn-primary hero-btn-glow">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <path d="M6 6h10"></path>
            <path d="M6 10h10"></path>
          </svg>
          <span>View Publications (15)</span>
        </a>

        <a href="/cv" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download CV</span>
        </a>

        <a href="/contact" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>Contact</span>
        </a>
      </div>

      <!-- Scholarly Profile Links -->
      <div class="hero-scholarly-links" aria-label="Scholarly Profiles">
        {profile.links.linkedin && (
          <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="LinkedIn Profile" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        )}

        {profile.links.googleScholar && (
          <a href={profile.links.googleScholar} target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="Google Scholar" aria-label="Google Scholar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </a>
        )}

        {profile.links.orcid && (
          <a href={profile.links.orcid} target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="ORCID Profile" aria-label="ORCID">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </a>
        )}

        {profile.links.github && (
          <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="social-icon-btn" title="GitHub Profile" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        )}
      </div>
    </div>

    <!-- High-Aesthetic Showcase Portrait Card (No square grids) -->
    <div class="hero-viewer-wrapper" id="hero-viewer-panel">
      <div class="portrait-halo" aria-hidden="true"></div>

      <div class="portrait-card">
        <div class="portrait-image-wrapper">
          <img
            src={portraitImg.src}
            alt={portraitImg.alt}
            width={portraitImg.width}
            height={portraitImg.height}
            loading="eager"
            fetchpriority="high"
            class="portrait-img"
          />
        </div>

        <!-- Floating Glassmorphic Info Badge -->
        <div class="portrait-floating-badge glass-panel">
          <div class="badge-icon-box">
            <span class="live-dot"></span>
          </div>
          <div class="badge-text-box">
            <span class="badge-title font-mono">MSc Data Intelligence · CCCU UK</span>
            <span class="badge-sub">Medical AI · 3D CT Segmentation</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(4.5rem, 9vw, 8rem);
    padding-bottom: clamp(4.5rem, 8vw, 7rem);
    overflow: hidden;
    background: transparent;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .availability-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    padding: 0.35rem 0.95rem;
    font-size: 0.82rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--accent-2);
    background: rgba(13, 148, 136, 0.08);
    border: 1px solid rgba(13, 148, 136, 0.25);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(13, 148, 136, 0.1);
  }

  .pulsing-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 10px var(--accent-2);
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.8); }
  }

  .hero-header-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero-eyebrow {
    font-size: 0.82rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero-title {
    color: var(--text-primary);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .hero-role-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .hero-role {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .hero-institution {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1.05rem;
    color: var(--accent);
    font-weight: 500;
  }

  .hero-quote-card {
    position: relative;
    padding: 0.85rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  .hero-positioning {
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-style: italic;
    line-height: 1.45;
  }

  .hero-bio {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 60ch;
    line-height: 1.65;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .hero-btn-glow {
    position: relative;
  }

  .hero-scholarly-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .social-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    color: var(--text-secondary);
    transition: all var(--transition-smooth);
    box-shadow: var(--shadow-sm);
  }

  .social-icon-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 16px -2px var(--accent-glow);
  }

  /* Right-Side Showcase Portrait Panel */
  .hero-viewer-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    perspective: 1200px;
  }

  .portrait-halo {
    position: absolute;
    width: 100%;
    max-width: 420px;
    height: 100%;
    background: radial-gradient(circle, var(--accent-glow) 0%, rgba(37, 99, 235, 0.08) 50%, transparent 70%);
    filter: blur(40px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .portrait-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-2xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    box-shadow: var(--shadow-lg);
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .portrait-card:hover {
    box-shadow: var(--shadow-hover);
  }

  .portrait-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--bg-subtle);
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portrait-card:hover .portrait-img {
    transform: scale(1.03);
  }

  /* Floating Badge Overlay */
  .portrait-floating-badge {
    position: absolute;
    bottom: -16px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 3rem);
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1.15rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border-hairline);
    z-index: 2;
  }

  .badge-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-subtle);
    flex-shrink: 0;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .badge-text-box {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .badge-title {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .badge-sub {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 960px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .hero-viewer-wrapper {
      max-width: 380px;
      margin: 0 auto;
    }
  }
</style>

<script>
  function setupHeroParallax() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.innerWidth < 1024) {
      return;
    }

    const panel = document.getElementById('hero-viewer-panel');
    const card = panel?.querySelector<HTMLElement>('.portrait-card');
    if (!panel || !card) return;

    panel.addEventListener('mousemove', (e) => {
      const rect = panel.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      const rotateX = (-y / rect.height) * 8;
      const rotateY = (x / rect.width) * 8;
      card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });

    panel.addEventListener('mouseleave', () => {
      card.style.transform = 'rotateX(0deg) rotateY(0deg)';
    });
  }

  setupHeroParallax();
  document.addEventListener('astro:page-load', setupHeroParallax);
</script>
