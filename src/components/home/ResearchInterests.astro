---
/**
 * ═════════════════════════════════════════════════════════════
 * [SECTION] ResearchInterests — Research Topics & Keywords Cloud
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Displays core research interest chips linking to
 *               filtered views on the publications page.
 * Data Source : src/content/site/profile.yaml
 * ═════════════════════════════════════════════════════════════
 */

import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  interests: string[];
}

const { interests } = Astro.props;
---

<section id="research-interests" class="section-padding container">
  <SectionHeading
    eyebrow="DOMAIN EXPERTISE"
    title="Research Interests & Methodological Focus"
    subtitle="Core themes spanning clinical machine learning, trustworthy AI algorithms, and volumetric imaging architectures."
  />

  <div class="interests-cloud">
    {interests.map((topic) => (
      <a href={`/publications?topic=${encodeURIComponent(topic)}`} class="chip interest-chip">
        <span class="chip-dot"></span>
        <span>{topic}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .interests-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    max-width: 960px;
  }

  .interest-chip {
    padding: 0.65rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-hairline);
    box-shadow: var(--shadow-sm);
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    transition: transform var(--transition-fast);
  }

  .interest-chip:hover {
    background: var(--bg-surface-elevated);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .interest-chip:hover .chip-dot {
    transform: scale(1.3);
  }
</style>
