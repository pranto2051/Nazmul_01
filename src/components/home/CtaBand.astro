---
/**
 * ═════════════════════════════════════════════════════════════
 * [SECTION] CtaBand — Collaboration & Supervision Call to Action
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Invitation for PhD supervision, research visits, and joint papers.
 * ═════════════════════════════════════════════════════════════
 */
---

<section id="cta-band" class="cta-band-section">
  <div class="container">
    <div class="cta-glass-card">
      <div class="cta-text-col">
        <span class="cta-eyebrow font-mono">NEXT STEP COLLABORATION</span>
        <h2 class="text-title-2 cta-heading">
          Interested in Collaboration or PhD Supervision Opportunities?
        </h2>
        <p class="cta-desc">
          Open to doctoral research discussions (2026/2027 intake), academic visits, and joint machine learning publications in medical image analysis.
        </p>
      </div>

      <div class="cta-actions-col">
        <a href="/contact" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>Get in Touch</span>
        </a>

        <a href="/cv" class="btn btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Full CV</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band-section {
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    position: relative;
  }

  .cta-glass-card {
    position: relative;
    padding: clamp(2.5rem, 5vw, 4rem);
    border-radius: var(--radius-2xl);
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-subtle) 100%);
    border: 1px solid var(--border-hairline);
    box-shadow: var(--shadow-lg), 0 0 40px rgba(56, 189, 248, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    overflow: hidden;
  }

  .cta-glass-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
    opacity: 0.12;
    filter: blur(60px);
    pointer-events: none;
  }

  .cta-eyebrow {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .cta-text-col {
    max-width: 650px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    position: relative;
    z-index: 1;
  }

  .cta-heading {
    color: var(--text-primary);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .cta-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .cta-actions-col {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .cta-glass-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
  }
</style>
