---
/**
 * ═════════════════════════════════════════════════════════════
 * [CARD] EducationCard — Education Credential Card
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Displays degree, institution, GPA/grade, thesis title, and core modules.
 * Props       : edu (degree, institution, grade, modules, thesisTitle, thesisPublicationId)
 * Data Source : src/content/education/education.yaml
 * ═════════════════════════════════════════════════════════════
 */

interface Props {
  edu: {
    id: string;
    degree: string;
    institution: string;
    location: string;
    period: string;
    grade: string;
    description: string;
    thesisTitle?: string;
    thesisPublicationId?: string;
    modules?: string[];
    highlights: string[];
  };
}

const { edu } = Astro.props;
---

<article class="education-card card-surface" id={`edu-${edu.id}`}>
  <div class="edu-header">
    <div class="edu-badge-row">
      <span class="edu-period font-mono">{edu.period}</span>
      <span class="edu-grade-pill font-mono">{edu.grade}</span>
    </div>
    <h3 class="paper-title edu-degree">{edu.degree}</h3>
    <p class="edu-institution">
      <strong>{edu.institution}</strong> · {edu.location}
    </p>
  </div>

  <p class="edu-desc">{edu.description}</p>

  {edu.thesisTitle && (
    <div class="edu-thesis-box">
      <span class="thesis-label font-mono">BACHELOR THESIS INVESTIGATION</span>
      <p class="thesis-title">"{edu.thesisTitle}"</p>
      {edu.thesisPublicationId && (
        <a href={`/publications#pub-${edu.thesisPublicationId}`} class="link-underlined thesis-pub-link">
          <span>Read Published Paper (IEEE ICCIT 2024, pp. 2014–2019) →</span>
        </a>
      )}
    </div>
  )}

  {edu.modules && edu.modules.length > 0 && (
    <div class="edu-modules-row">
      <span class="modules-label font-mono">Core Modules:</span>
      <div class="modules-chips">
        {edu.modules.map((mod) => (
          <span class="chip module-chip">{mod}</span>
        ))}
      </div>
    </div>
  )}

  <ul class="edu-highlights-list">
    {edu.highlights.map((h) => (
      <li class="edu-highlight-item">
        <span class="edu-bullet">▪</span>
        <span>{h}</span>
      </li>
    ))}
  </ul>
</article>

<style>
  .education-card {
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-left: 5px solid var(--accent);
    box-shadow: var(--shadow-card);
    transition: all var(--transition-smooth);
  }

  .education-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(56, 189, 248, 0.4);
    border-left-color: var(--accent);
  }

  .edu-header {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .edu-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .edu-period {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .edu-grade-pill {
    font-size: 0.76rem;
    padding: 0.25rem 0.75rem;
    background: var(--accent-subtle);
    color: var(--accent);
    border-radius: var(--radius-full);
    font-weight: 700;
    border: 1px solid var(--border-hairline);
  }

  .edu-degree {
    font-size: 1.4rem;
    color: var(--text-primary);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .edu-institution {
    font-size: 1.05rem;
    color: var(--text-secondary);
  }

  .edu-desc {
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .edu-thesis-box {
    padding: 1.35rem;
    border-radius: var(--radius-lg);
    background: var(--bg-subtle);
    border: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .thesis-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .thesis-title {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--text-primary);
  }

  .thesis-pub-link {
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }

  .edu-modules-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .modules-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .modules-chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .module-chip {
    font-size: 0.78rem;
    padding: 0.2rem 0.55rem;
  }

  .edu-highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .edu-highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .edu-bullet {
    color: var(--accent);
  }
</style>
