---
/**
 * ═════════════════════════════════════════════════════════════
 * [CARD] AwardCard — Honors & Certification Card
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Professional certifications, awards, and credentials
 *               with optional certificate verification / lightbox view.
 * Props       : award (title, issuer, year, description, certificateKey)
 * Data Source : src/content/awards/awards.yaml
 * ═════════════════════════════════════════════════════════════
 */

import { IMG } from '../../data/images';
import Figure from '../media/Figure.astro';

interface Props {
  award: {
    id: string;
    title: string;
    issuer: string;
    year: string;
    description: string;
    certificateKey?: string;
  };
}

const { award } = Astro.props;
const certImg = award.certificateKey ? IMG[award.certificateKey] : undefined;
---

<article class="award-card card-surface" id={`award-${award.id}`}>
  <div class="award-content-col">
    <div class="award-meta-row">
      <span class="award-year font-mono">{award.year}</span>
      <span class="meta-dot">·</span>
      <span class="award-issuer font-mono">{award.issuer}</span>
    </div>

    <h3 class="paper-title award-title">{award.title}</h3>
    <p class="award-desc">{award.description}</p>
  </div>

  {certImg && (
    <div class="award-cert-col">
      <Figure
        imageKey={award.certificateKey}
        caption="Verified Credential Document"
        lightboxId={`cert-${award.id}`}
      />
    </div>
  )}
</article>

<style>
  .award-card {
    padding: 1.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    border-left: 4px solid var(--accent);
  }

  .award-content-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .award-meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
  }

  .award-year {
    font-weight: 700;
    color: var(--accent);
  }

  .award-issuer {
    color: var(--text-muted);
  }

  .award-title {
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .award-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .award-cert-col {
    max-width: 320px;
  }

  @media (min-width: 768px) {
    .award-card:has(.award-cert-col) {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
    }
  }
</style>
