---
/**
 * ═════════════════════════════════════════════════════════════
 * [CARD] TimelineItem — Experience Timeline Item
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Displays role, organization, duration, type (Research/Professional), and achievements.
 * Props       : exp (role, organisation, location, period, type, current, bullets)
 * Data Source : src/content/experience/experience.yaml
 * ═════════════════════════════════════════════════════════════
 */

interface Props {
  exp: {
    id: string;
    role: string;
    organisation: string;
    location: string;
    period: string;
    type: 'research' | 'professional';
    current: boolean;
    bullets: string[];
  };
}

const { exp } = Astro.props;
---

<div class="experience-timeline-node" id={`exp-${exp.id}`}>
  <div class="node-marker-col">
    <div class={`exp-bullet-ring ${exp.current ? 'current-ring' : ''}`}>
      <span class="exp-bullet-dot"></span>
    </div>
    <div class="exp-vertical-line"></div>
  </div>

  <article class="exp-content-card card-surface">
    <div class="exp-header-row">
      <div class="exp-title-block">
        <h3 class="paper-title exp-role">{exp.role}</h3>
        <p class="exp-org">
          <strong>{exp.organisation}</strong> · {exp.location}
        </p>
      </div>

      <div class="exp-badge-group">
        <span class="exp-period font-mono">{exp.period}</span>
        <span class={`type-pill ${exp.type}`}>
          {exp.type === 'research' ? 'Research Appointment' : 'Industry Role'}
        </span>
      </div>
    </div>

    <ul class="exp-bullets-list">
      {exp.bullets.map((bullet) => (
        <li class="bullet-item">
          <span class="bullet-tick">▪</span>
          <span>{bullet}</span>
        </li>
      ))}
    </ul>
  </article>
</div>

<style>
  .experience-timeline-node {
    display: flex;
    gap: 1.5rem;
    position: relative;
  }

  .node-marker-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 24px;
    flex-shrink: 0;
  }

  .exp-bullet-ring {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg-surface);
    border: 2px solid var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.75rem;
    z-index: 2;
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .current-ring {
    border-color: var(--accent-2);
    box-shadow: 0 0 12px rgba(45, 212, 191, 0.5);
  }

  .exp-bullet-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .current-ring .exp-bullet-dot {
    background: var(--accent-2);
  }

  .exp-vertical-line {
    width: 2px;
    background: linear-gradient(180deg, var(--accent) 0%, var(--border-hairline) 100%);
    flex: 1;
    margin: 0.5rem 0;
  }

  .exp-content-card {
    flex: 1;
    padding: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    box-shadow: var(--shadow-card);
    transition: all var(--transition-smooth);
  }

  .exp-content-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(56, 189, 248, 0.4);
  }

  .exp-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .exp-role {
    font-size: 1.35rem;
    color: var(--text-primary);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .exp-org {
    font-size: 0.98rem;
    color: var(--text-secondary);
  }

  .exp-badge-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .exp-period {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }

  .type-pill {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-full);
  }

  .type-pill.research {
    background: rgba(13, 148, 136, 0.12);
    color: var(--accent-2);
    border: 1px solid var(--accent-2);
  }

  .type-pill.professional {
    background: rgba(37, 99, 235, 0.12);
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .exp-bullets-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .bullet-tick {
    color: var(--accent);
  }
</style>
