---
/**
 * ═════════════════════════════════════════════════════════════
 * [COMPONENT] DraftBadge — Demo & Draft Integrity Badge
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Preserves academic integrity by visibly flagging unverified/demo data
 *               during development.
 * Props       : text (default: 'Demo — verify')
 * Data Source : import.meta.env.DEV or PUBLIC_SHOW_DRAFT
 * Used In     : Cards, results grids, and figures
 * ═════════════════════════════════════════════════════════════
 */

interface Props {
  text?: string;
  className?: string;
}

const { text = 'Demo — verify', className = '' } = Astro.props;

// Only rendered in development mode or when PUBLIC_SHOW_DRAFT is set to true
const showBadge = import.meta.env.DEV || process.env.PUBLIC_SHOW_DRAFT === 'true';
---

{showBadge && (
  <span class={`draft-badge ${className}`} title="This item contains placeholder/unverified data. Verify before final submission.">
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
      <line x1="12" y1="9" x2="12" y2="13"/>
      <line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
    <span>{text}</span>
  </span>
)}
