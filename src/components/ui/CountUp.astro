---
/**
 * ═════════════════════════════════════════════════════════════
 * [COMPONENT] CountUp — Animated Metric Number Counter
 * ─────────────────────────────────────────────────────────────
 * Purpose     : Smooth count-up micro-animation for quantitative stats.
 * Props       : target (number), suffix (e.g. '+', '%'), prefix
 * Data Source : Stats Bento & profile metrics
 * ═════════════════════════════════════════════════════════════
 */

interface Props {
  target: number;
  suffix?: string;
  prefix?: string;
  decimals?: number;
  className?: string;
}

const { target, suffix = '', prefix = '', decimals = 0, className = '' } = Astro.props;
---

<span class={`count-up-container ${className}`} data-countup-target={target} data-decimals={decimals}>
  {prefix}<span class="count-up-value font-mono">{target.toFixed(decimals)}</span>{suffix}
</span>

<script>
  function initCountUps() {
    // Respect prefers-reduced-motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const elements = document.querySelectorAll<HTMLElement>('[data-countup-target]');
    
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        
        const el = entry.target as HTMLElement;
        const targetVal = parseFloat(el.getAttribute('data-countup-target') || '0');
        const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
        const valSpan = el.querySelector('.count-up-value');
        if (!valSpan) return;

        let start = 0;
        const duration = 1200; // ms
        const startTime = performance.now();

        function update(now: number) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Ease-out cubic curve
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          const current = start + (targetVal - start) * easeProgress;

          valSpan!.textContent = current.toFixed(decimals);

          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            valSpan!.textContent = targetVal.toFixed(decimals);
          }
        }

        requestAnimationFrame(update);
        obs.unobserve(el);
      });
    }, { threshold: 0.2 });

    elements.forEach(el => observer.observe(el));
  }

  initCountUps();
  document.addEventListener('astro:page-load', initCountUps);
</script>

<style>
  .count-up-container {
    display: inline-flex;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
  }
</style>
